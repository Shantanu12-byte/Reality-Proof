# ============================================================
# RealityProof — Frontend Environment Variables (.env.example)
# Copy this file to .env.local and fill in values
# DO NOT commit the actual .env.local file to version control
# ============================================================

# API base URL — point to your deployed backend in production
# The httpClient in src/shared/services/httpClient.js reads VITE_API_URL
# In development this is proxied through Vite to localhost:5000
# In production, set this to your deployed backend URL:
# Example: https://realityproof-api.onrender.com/api
VITE_API_URL=/api
