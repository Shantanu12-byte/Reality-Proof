# ============================================================
# RealityProof — Backend Environment Variables
# Copy this file to backend/.env and fill in your credentials
# DO NOT commit the actual backend/.env file to version control
# ============================================================

# ── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── Database ─────────────────────────────────────────────────
# For local dev: mongodb://127.0.0.1:27017/realityproof
# For production: Use MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/realityproof
DB_NAME=RealityProof

# ── CORS / Frontend URL ──────────────────────────────────────
# Set to your Vercel frontend domain in production
CLIENT_URL=http://localhost:3000

# ── JWT Auth ─────────────────────────────────────────────────
# Must be a strong random string >= 32 characters
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_MIN_32_CHARS

# ── AI Vision: Groq (Primary) ───────────────────────────────
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=openai/gpt-oss-20b

# ── AI Vision: Google Gemini (Fallback) ──────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash

# ── PayPal (Sandbox → Production) ───────────────────────────
# Change PAYPAL_MODE to "live" for production
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID_HERE
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET_HERE
PAYPAL_WEBHOOK_ID=YOUR_PAYPAL_WEBHOOK_ID_HERE
PAYPAL_CURRENCY=USD
PAYPAL_PAYOUTS_ENABLED=false
